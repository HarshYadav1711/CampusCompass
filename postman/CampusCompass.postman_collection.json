{
  "info": {
    "name": "CampusCompass",
    "description": "CampusCompass API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Add school",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Riverside Academy\",\n  \"address\": \"100 Campus Way, Springfield\",\n  \"latitude\": 40.7128,\n  \"longitude\": -74.006\n}"
        },
        "url": "{{baseUrl}}/addSchool",
        "description": "Requires MySQL and sql/schema.sql applied. Set baseUrl if not localhost:3000."
      }
    },
    {
      "name": "List schools by distance",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/listSchools?latitude=40.7128&longitude=-74.006",
        "description": "Query: latitude and longitude (required). Nearest schools first."
      }
    }
  ]
}
